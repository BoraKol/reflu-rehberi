# =============================================================================
# Sunucu Tarafı Gizli Değişkenler (ASLA istemci koduna veya Git'e eklemeyin)
# =============================================================================

# GEMINI_API_KEY: Doğal dil ve öğün fotoğrafı ayrıştırma için (opsiyonel — yoksa çevrimdışı ayrıştırıcı çalışır)
GEMINI_API_KEY=""

# APP_URL: Üretim ortamındaki uygulama URL'niz (Origin doğrulaması için)
APP_URL="https://uygulamaniz.example.com"

# ALLOWED_ORIGINS: İsteğe bağlı virgülle ayrılmış ek izinli kökenler
# ALLOWED_ORIGINS="https://www.uygulamaniz.example.com"

# PORT: Express sunucu portu (varsayılan: 3000)
PORT="3000"

# =============================================================================
# İstemci Tarafı Firebase Yapılandırması (Vite — VITE_ öneki ile)
# Not: Google Cloud Console'da API Key için HTTP Referrer kısıtlaması ekleyin.
# =============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID="(default)"
